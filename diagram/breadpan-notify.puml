@startuml breadpan-notify
participant Item
participant "内部 tokio 运行时" as rt
participant "事件通道" as ch

Item -> rt: PropertiesChanged
Item -> rt: 官方 New* 信号
note right of Item
  NewStatus / NewIcon / NewTitle / NewToolTip /
  NewOverlayIcon / NewAttentionIcon（§3.3）
end note
note right of rt
  （窗口内按 Item 合并）
end note
rt -> ch: Changed(id)
note right of ch
  轻量事实：不含数据
  消费方重读 item(id) 取最新
end note
@enduml
