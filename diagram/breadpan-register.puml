@startuml breadpan-register
participant "Item 应用" as item
participant "breadpan（watcher 模块）" as bp
participant "事件通道" as ch

item -> bp: RegisterItem(唯一名 + 路径)
bp -> bp: == 登记最小集入册（幂等；探测 Menu 属性）==
bp -> ch: Added(id)
note over item: （Item 进程退出 / 崩溃）
item --> bp: NameOwnerChanged(唯一名, "")
bp -> bp: == 簿记移除 ==
bp -> ch: Removed
@enduml
