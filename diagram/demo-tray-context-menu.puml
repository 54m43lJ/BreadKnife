@startuml demo-tray-context-menu
actor 用户
participant "demo-tray UI" as ui
participant breadpan
participant "演示 Item" as item

用户 -> ui: 右键
ui -> breadpan: right_click
breadpan -> item: AboutToShow
note right of item: （内含前置通知）
item --> breadpan: 需要更新?
breadpan -> item: GetLayout
ui <-- breadpan: 全量快照
item --> breadpan: 布局 + 属性
ui -> ui: == 渲染弹出 ==
用户 -> ui: 点条目
ui -> breadpan: menu_activate
breadpan -> item: Event
ui <-- breadpan: 回执事件（日志可见）
item --> breadpan: 结果
note over ui
  popup 打开期间 menu add/remove → MenuChanged →
  demo-tray 重取 menu() → 菜单内容更新
end note
@enduml
