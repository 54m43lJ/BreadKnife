@startuml breadknife-architecture
skinparam componentStyle rectangle

component "breadknife（bread）" as bread
component "Hyprland（合成器）" as hypr
component "DBus 服务\nUPower / NetworkManager / BlueZ / MPRIS" as svc
component "调用方\n（脚本 / 命令行）" as client
component "托盘 Item（外部应用）" as items
component "通知发送方（外部应用）" as notify
component "调节后端\npamixer / brightnessctl / ddcutil" as tools

hypr -down-> bread : IPC 只读事件
svc <-> bread : DBus 状态与操作
client -down-> bread : bread.sock 控制指令
bread -up- items : SNI / DBusMenu
notify -up-> bread : org.freedesktop.Notifications
bread -right-> tools : 调起（音量 / 亮度）
@enduml
